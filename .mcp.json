{
  "mcpServers": {
    "dev-kb": {
      "type": "stdio",
      "command": ".venv/bin/python",
      "args": [
        "-m",
        "agent_app.mcp_server"
      ],
      "env": {
        "PYTHONPATH": "src",
        "HF_HUB_OFFLINE": "1"
      }
    },
    "dev-kb-contract": {
      "type": "stdio",
      "command": ".venv/bin/python",
      "args": [
        "-m",
        "agent_app.contract.mcp_server"
      ],
      "env": {
        "PYTHONPATH": "src"
      }
    }
  }
}
